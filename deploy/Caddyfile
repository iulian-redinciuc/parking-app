# Production public entry + frontend (parking-web image). Spec: docs/design/deployment.md §5 Option B, §6
# One HTTPS origin: /api/* and /healthz go to the API, everything else is the built frontend.
# /internal/*, /control/*, /docs and any other path have no route to the API: they end in the
# file server, which answers 404.
#   PUBLIC_HOST   the public hostname (Caddy gets and renews its certificate by itself);
#                 `localhost` = Caddy's own test certificate
#   API_UPSTREAM  where the API listens (default api:8000, the compose service)
{
	admin off
}

{$PUBLIC_HOST:localhost} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		# no other site may put the app in a frame (a <meta> CSP can't say this; the rest of the
		# policy is the <meta> in index.html)
		Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@api path /api/* /healthz
	handle @api {
		reverse_proxy {$API_UPSTREAM:api:8000} {
			# -1: pass SSE events on at once
			flush_interval -1
		}
	}

	handle {
		root * /srv
		encode zstd gzip
		# hashed file names never change; the page, the service worker and the manifest must be
		# checked on every load so a new release reaches installed apps
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@entry path / /index.html /sw.js /registerSW.js /manifest.webmanifest
		header @entry Cache-Control "no-cache"
		file_server
	}
}
