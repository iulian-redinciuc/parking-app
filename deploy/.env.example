# Template for deploy/.env. Spec: docs/design/config.md §5
#   cp deploy/.env.example deploy/.env    # deploy/.env is git-ignored: never commit it
# Values below are empty or dummies. Fill in real ones only in deploy/.env.

# --- General (all services) ---
# Time zone for schedules and stats buckets; also fills ${TZ} in lot.yaml
TZ=Europe/Bucharest
# Path to the lot config inside the containers
PARKING_CONFIG=/app/config/lot.yaml
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Lot location (API; fills ${LOT_LAT}/${LOT_LON} in lot.yaml). Kept here so it stays out of git ---
# Dummy values (Westminster); replace with the lot's coordinates
LOT_LAT=51.5007
LOT_LON=-0.1246

# --- API ---
# SQLite database URL (four slashes = absolute path)
PARKING_DB_URL=sqlite:////app/data/db/parking.sqlite
# Host port for the API, bound to 127.0.0.1 only by compose
API_HOST_PORT=8000
# Allowed frontend origins, comma-separated. Dev: the GitHub Pages preview; prod: the production frontend origin
CORS_ORIGINS=https://iulian-redinciuc.github.io
# Frontend URL used in notification links. Dev: the preview; prod: the production frontend URL
PUBLIC_APP_URL=https://iulian-redinciuc.github.io/parking-app/

# --- Internal API <-> workers ---
# Shared token for /internal/* and the workers' /control/*. Generate: openssl rand -hex 32
WORKER_TOKEN=
# How workers reach the API: http://api:8000 on the same machine, http://<api-vpn-address>:8000 in T2
API_INTERNAL_URL=http://api:8000

# --- Cameras (workers). Contain usernames/passwords: real values only in deploy/.env ---
# Occupancy camera (Camera B): HTTP snapshot URL and/or RTSP URL, e.g. http://user:pass@10.0.20.11/...
CAM_GROUND_SNAPSHOT_URL=
CAM_GROUND_RTSP_URL=
# Flow camera (Camera A), e.g. rtsp://user:pass@10.0.20.12:554/sub
CAM_RAMP_RTSP_URL=

# --- Web Push (API) ---
# Generate with: parking push vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:you@example.com
VAPID_SUBJECT=mailto:you@example.com

# --- Admin (API) ---
# Generate with: parking admin hash-password (paste its line as printed, single quotes included)
ADMIN_PASSWORD_HASH=
# Long random string for scripts (and admin access before the Phase 7 login exists). Generate: openssl rand -hex 32
ADMIN_TOKEN=

# --- Debug frame capture (workers) ---
# Save analysed frames + observation JSON to data/debug/<camera>/<date>/ (true | false), every
# DEBUG_CAPTURE_EVERY_MIN minutes and on every slot flip; files older than DEBUG_RETENTION_HOURS are deleted
# (also with capture off). Frames can show people and plates: keep it off unless debugging.
DEBUG_CAPTURE=false
DEBUG_CAPTURE_EVERY_MIN=10
DEBUG_RETENTION_HOURS=24

# --- Public entry + frontend (production server: parking-web, compose profile "web"; deployment.md §5-§6) ---
# The app's public hostname: a domain or subdomain whose DNS A record points at the server, or without a
# domain <the server's IPv4 with dashes>.sslip.io (e.g. 203-0-113-7.sslip.io). Then
# CORS_ORIGINS=https://<PUBLIC_HOST> and PUBLIC_APP_URL=https://<PUBLIC_HOST>/
PUBLIC_HOST=

# --- Public entry (cloudflared, compose profile "public") ---
# Tunnel token from the Cloudflare dashboard (Zero Trust -> Networks -> Tunnels)
TUNNEL_TOKEN=

# --- Compose (per machine; see deployment.md §4) ---
# Image tag to run; pin a release tag (v0.x.y) in production, never latest
PARKING_VERSION=latest
# T2 production only (docker-compose.server.yml / docker-compose.site.yml): this machine's own address on
# the private VPN; the API (server) and the workers' control ports (lot box) are published on it
VPN_BIND_IP=
# CPU limits for the vision workers; tune per machine
VISION_CPUS=1.0
FLOW_CPUS=1.5
